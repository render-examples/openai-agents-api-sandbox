{
  "name": "openai-agents-api-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Run an OpenAI Agents API self-hosted environment in a Render Sandbox",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@renderinc/sdk": "1.3.0",
    "dotenv": "17.2.3",
    "openai": "7.39.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
