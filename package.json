  },
  "dependencies": {
    "@renderinc/sdk": "1.3.0",
    "dotenv": "17.2.3",
    "openai": "7.39.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
