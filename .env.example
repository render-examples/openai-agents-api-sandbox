# Render
RENDER_API_KEY=
RENDER_WORKSPACE_ID=

# OpenAI
# Application credential: used only by this local process.
OPENAI_API_KEY=
# Environment key: injected only as sandbox-side CODEX_API_KEY. Create it on the
# Agents tab (https://platform.openai.com/agents?tab=environments&environment_view=keys),
# not the API keys page, in the same project and user as OPENAI_API_KEY.
OPENAI_EXECUTOR_API_KEY=

# Optional
OPENAI_MODEL=gpt-6-astra
AGENT_TIMEOUT_SECONDS=600
